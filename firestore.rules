rules_version = '2';

// 이 규칙은 js/fsm.js의 유한 상태 기계 전이 테이블을 서버(Firestore) 단에서
// 다시 한번 강제한다. 클라이언트 코드를 임의로 조작하더라도, 아래 규칙을
// 우회해서 COMPLETED(인계완료) 상태로 바꿀 수 없다.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // 관리자 명단: Firestore 콘솔에서 admins/{관리자uid} 문서를 직접 만들어 등록한다.
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /items/{itemId} {
      // 공개 필드(사진, 장소, 카테고리 등)는 누구나 조회 가능
      allow read: if true;
      allow create: if isSignedIn();
      allow delete: if isAdmin();

      allow update: if isSignedIn() && (
        isAdmin() ||
        // 일반 사용자(학생)는 아래 두 전이만 직접 호출할 수 있음
        (resource.data.status == 'REGISTERED' && request.resource.data.status == 'CLAIMED') ||
        (resource.data.status == 'CLAIMED' && request.resource.data.status == 'VERIFYING')
      );

      // 비공개 특징: 관리자만 읽을 수 있음
      match /private/{docId} {
        allow read: if isAdmin();
        allow write: if isSignedIn();
      }

      // 신고 내역: 관리자만 읽을 수 있음 (신고자 개인정보 보호)
      match /claims/{claimId} {
        allow read: if isAdmin();
        allow create: if isSignedIn();
        allow update: if isAdmin();
      }
    }
  }
}
